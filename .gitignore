# Dependencies and build output
node_modules
dist

# Local overrides, never shared: .env.local, .env.development.local, …
# (.env.production is tracked: it holds only the public address of the sync relay.
# Anything in a VITE_ variable ends up in the built files, so no secret belongs there.)
*.local

# macOS
.DS_Store

# Claude Code: local settings and its copies of the repository
.claude

# Archives of folders that are in the repository anyway
*.zip
